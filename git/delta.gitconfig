# Included from ~/.gitconfig by install.sh. Side-by-side, syntax-highlighted
# diffs for git diff / show / log -p, plus lazygit.
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = Visual Studio Dark+  # bat has no GitHub Dark theme built in
[merge]
	conflictStyle = zdiff3
