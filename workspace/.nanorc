# GitHub Dark theme for nano, matched to Cursor. nano takes only named colors or
# 3-digit #RGB, mapped to the nearest 256-color cube slot.

set linenumbers
set mouse
set softwrap
set atblanks
set autoindent
set smarthome
set indicator
set minibar
set stateflags
set zap
set historylog
set positionlog
set tabsize 4

# nano uses the LAST matching syntax, so the custom GitHub Dark files go after the stock ones.
include "/opt/homebrew/share/nano/*.nanorc"
include "/opt/homebrew/share/nano/extra/*.nanorc"
include "~/.nano-syntax/*.nanorc"
